{
  "capabilityKey": "sema.listing.write-copy",
  "version": "1.1.0",
  "displayName": "Write Listing Copy",
  "description": "Writes listing text for one item on one platform: titles, descriptions, tags and bullet points, following the platform's rules given as data. The application sends the prompts, one per AI service and a default; a service only talks to its AI and returns this shape. Several services (one per AI) may be asked at once, and a person chooses or combines.",
  "choosing": [
    "consensus",
    "dynamic",
    "bound"
  ],
  "operations": [
    {
      "key": "generate",
      "required": true,
      "description": "Writes the number of variants asked for, using the prompt the application sent for this service (or its default). Each variant comes with its rule check: where it breaks the platform's rules, so nothing is published that the platform would refuse.",
      "input": {
        "type": "object",
        "required": [
          "item",
          "platform",
          "prompts"
        ],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "object",
            "description": "The facts about the item. Only what is given here may be stated as fact.",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 500,
                "description": "A working title or name"
              },
              "notes": {
                "type": "string",
                "maxLength": 5000,
                "description": "Anything else the seller knows about it"
              },
              "brand": {
                "type": "string",
                "maxLength": 200
              },
              "category": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "maxLength": 200
                },
                "description": "The category's full path, from the top"
              },
              "attributes": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 500
                    }
                  }
                }
              },
              "condition": {
                "type": "string",
                "maxLength": 500
              },
              "measurements": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "unit": {
                      "type": "string",
                      "maxLength": 20
                    }
                  }
                }
              },
              "mustSay": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 500
                },
                "description": "Things the seller wants said"
              }
            }
          },
          "photos": {
            "type": "array",
            "maxItems": 20,
            "description": "Photos by reference (for example a Foundation Resource file). A service that cannot read them ignores them and says so.",
            "items": {
              "type": "object",
              "required": [
                "ref"
              ],
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "maxLength": 2000
                },
                "mimeType": {
                  "type": "string",
                  "maxLength": 100
                }
              }
            }
          },
          "platform": {
            "type": "object",
            "description": "The target platform's rules, as data.",
            "required": [
              "name",
              "title",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "title": {
                "type": "object",
                "required": [
                  "maxLength"
                ],
                "additionalProperties": false,
                "properties": {
                  "maxLength": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                }
              },
              "description": {
                "type": "object",
                "required": [
                  "format",
                  "maxLength"
                ],
                "additionalProperties": false,
                "properties": {
                  "format": {
                    "type": "string",
                    "enum": [
                      "plain",
                      "html",
                      "markdown"
                    ]
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  }
                }
              },
              "tags": {
                "type": "object",
                "required": [
                  "count",
                  "maxLength"
                ],
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200
                  }
                }
              },
              "bullets": {
                "type": "object",
                "required": [
                  "count",
                  "maxLength"
                ],
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                }
              },
              "forbiddenWords": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "string",
                  "maxLength": 100
                }
              }
            }
          },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tone": {
                "type": "string",
                "maxLength": 100,
                "description": "For example plain, friendly or technical"
              },
              "language": {
                "type": "string",
                "maxLength": 50,
                "description": "For example en-US"
              },
              "alwaysUse": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "maxLength": 100
                }
              },
              "neverUse": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "string",
                  "maxLength": 100
                }
              }
            }
          },
          "variants": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "How many variants to write; 1 when left out"
          },
          "prompts": {
            "type": "object",
            "description": "The application's prompts (D-169): one for each service named, and a default for any other.",
            "required": [
              "default"
            ],
            "additionalProperties": false,
            "properties": {
              "default": {
                "type": "object",
                "required": [
                  "version",
                  "system",
                  "request"
                ],
                "additionalProperties": false,
                "properties": {
                  "version": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "The application's ID for this prompt version; the answer names it"
                  },
                  "system": {
                    "type": "string",
                    "maxLength": 20000,
                    "description": "The instructions"
                  },
                  "request": {
                    "type": "string",
                    "maxLength": 50000,
                    "description": "The request, already filled in with this item's facts"
                  }
                }
              },
              "byService": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": [
                    "service",
                    "version",
                    "system",
                    "request"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "service": {
                      "type": "string",
                      "maxLength": 120,
                      "description": "The service key this prompt is for"
                    },
                    "version": {
                      "type": "string",
                      "maxLength": 200,
                      "description": "The application's ID for this prompt version; the answer names it"
                    },
                    "system": {
                      "type": "string",
                      "maxLength": 20000,
                      "description": "The instructions"
                    },
                    "request": {
                      "type": "string",
                      "maxLength": 50000,
                      "description": "The request, already filled in with this item's facts"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "output": {
        "type": "object",
        "required": [
          "variants",
          "photosUsed",
          "promptVersion"
        ],
        "properties": {
          "variants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": [
                "title",
                "description",
                "tags",
                "ruleCheck"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 1000
                },
                "description": {
                  "type": "string",
                  "maxLength": 100000
                },
                "tags": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "bullets": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "ruleCheck": {
                  "type": "array",
                  "description": "Where this variant breaks the platform's rules; empty when it breaks none",
                  "items": {
                    "type": "object",
                    "required": [
                      "field",
                      "problem"
                    ],
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "problem": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "photosUsed": {
            "type": "boolean",
            "description": "Whether the service looked at the photos"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000,
            "description": "Anything the service wants the person to know, such as facts it was not given"
          },
          "usage": {
            "type": "object",
            "description": "The AI's own usage figures, for cost",
            "properties": {
              "model": {
                "type": "string"
              },
              "inputTokens": {
                "type": "integer"
              },
              "outputTokens": {
                "type": "integer"
              }
            }
          },
          "promptVersion": {
            "type": "string",
            "maxLength": 200,
            "description": "Which prompt version wrote this answer"
          }
        }
      }
    }
  ]
}
